{
  "name": "fespay",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.5.1",
  "scripts": {
    "setup:dev": "node scripts/setup-dev.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "tsx --test apps/api/test/unit.test.ts apps/api/test/http-input.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 apps/api/test/integration.test.ts",
    "check:design": "node scripts/check-design.mjs",
    "db:migrate:dev": "node --env-file-if-exists=.env --import tsx database/migrate.ts --development",
    "db:status:dev": "node --env-file-if-exists=.env --import tsx database/migrate.ts --development --status"
  },
  "devDependencies": {
    "@redocly/cli": "2.60.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
